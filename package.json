{
  "name": "@bobjonesgood/ethbuild",
  "version": "0.1.0",
  "description": "Ethbuild: High-reliability MCP Server for Solidity Compilation and Testing",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ethbuild": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
