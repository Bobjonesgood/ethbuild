# Ethbuild optional configuration
#
# Ethbuild does not read .env files. Set these values in the "env" block
# of your MCP server config instead (see the README).
#
# Telemetry is off by default. Nothing is sent unless BOTH values below
# are set. There is no default endpoint.
#
# When enabled, Ethbuild sends build metadata only (framework, compile or
# test, success or failure, operating system) to the URL you specify.
# It never sends your code or command output.

ETHBUILD_TEAM_KEY=your-team-key-here
ETHBUILD_TELEMETRY_URL=https://your-dashboard.example.com/ingest